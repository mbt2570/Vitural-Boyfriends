# ============================================================================
# 纸片人男友 — 环境变量示例
# 使用方法：复制此文件为 .env.local，填入真实值
# ============================================================================

# ==================== 数据库（必填） ====================
# Neon PostgreSQL / Supabase / 任何 Postgres
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# ==================== NextAuth（必填） ====================
AUTH_URL="http://localhost:3000"
# 用 openssl rand -base64 32 或 https://generate-secret.vercel.app/32 生成
AUTH_SECRET="change-me-to-a-random-string"

# ==================== LLM 对话（必填） ====================
# 默认 OpenRouter（多模型聚合，支持 vision）
# 也可直连硅基流动：https://api.siliconflow.cn/v1
LLM_API_KEY="sk-or-v1-..."
LLM_API_BASE="https://openrouter.ai/api/v1"
# 推荐模型：z-ai/glm-5.3-flash（多模态，支持看图）
LLM_MODEL="z-ai/glm-5.3-flash"

# ==================== 图生图（可选） ====================
# 用于未来"角色换形象生成"功能
IMAGE_API_KEY=""
IMAGE_API_BASE="https://ark.cn-beijing.volces.com/api/v3"
IMAGE_MODEL="doubao-seedream-5-0-260128"

# ==================== TTS 语音合成（可选） ====================
# 默认 OpenRouter 代理的 MiniMax
# 硅基流动替代：LLM_API_BASE=https://api.siliconflow.cn/v1, TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_API_KEY="sk-or-v1-..."
TTS_API_BASE="https://openrouter.ai/api/v1"
TTS_MODEL="minimax/speech-2.8-turbo"
TTS_RESPONSE_FORMAT="mp3"

# ==================== STT 语音识别（可选） ====================
# 硅基流动 FunAudioLLM/SenseVoiceSmall
STT_API_KEY="sk-..."
STT_API_BASE="https://api.siliconflow.cn/v1"
STT_MODEL="FunAudioLLM/SenseVoiceSmall"

# ==================== 公开 URL（可选，本地部署时用于图片转 base64） ====================
# 生产环境填你的域名，本地默认 http://localhost:3000
# NEXT_PUBLIC_APP_URL="https://your-domain.com"
