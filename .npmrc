# pnpm v9+ 安全机制：白名单允许必要的 build scripts 运行
# esbuild: Next.js Turbopack 的原生模块，不编译会导致运行时找不到二进制
# bcrypt: 需要编译 native binding 做密码加密
# unrs-resolver: Next.js 内部依赖
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=bcrypt
onlyBuiltDependencies[]=unrs-resolver

# Vercel 构建环境里常见的额外包
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=workerd
